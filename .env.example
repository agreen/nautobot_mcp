# Nautobot MCP Server Configuration
# Copy this file to .env and update the values as needed

# Environment Configuration - Change this ONE setting to switch environments
# Available options: "local", "nonprod", "prod"
NAUTOBOT_ENV=local

# Environment-specific credentials (only needed if overriding creds_helper defaults)
# For LOCAL environment:
# NAUTOBOT_LOCAL_BASE_URL=http://nautobot:8080/   # default http://localhost:8080/
# NAUTOBOT_LOCAL_TOKEN=your_local_token_here

# For NONPROD environment:
# NAUTOBOT_NONPROD_BASE_URL=https://your-nonprod-nautobot.com/
# NAUTOBOT_NONPROD_TOKEN=your_nonprod_token_here

# For PROD environment:
# NAUTOBOT_PROD_BASE_URL=https://your-prod-nautobot.com/
# NAUTOBOT_PROD_TOKEN=your_prod_token_here

# Server Configuration
API_PREFIX=nautobot_openapi
SERVER_NAME=any_openapi
SERVER_VERSION=0.2.0
NAUTOBOT_TOKEN=""
GITHUB_TOKEN=""

SSL_VERIFY=False

# Logging
LOG_LEVEL=INFO

# ChromaDB Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_SEARCH_RESULTS=5
TOKENIZERS_PARALLELISM=false

# External Services
POSTHOG_API_KEY=disable

# Request Configuration
API_TIMEOUT=10

# MCP Transport Configuration
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1   # use 0.0.0.0 inside a container
MCP_PORT=8000

# Seconds to wait for Nautobot's Swagger schema (large instances are slow)
SCHEMA_TIMEOUT=120

# Where indexes / cloned KB repos are stored (point at a persistent volume in Docker)
# NAUTOBOT_MCP_DATA_DIR=/data/chroma
# NAUTOBOT_MCP_REPO_CACHE=/data/repos
