# Nautobot MCP Server configuration. Everything is a plain environment variable;
# copy this file to .env (or pass the variables in your MCP client / MetaMCP config).

# --- Nautobot connection (required) ---------------------------------------------
NAUTOBOT_URL=http://localhost:8080        # base URL; a trailing /api is tolerated
NAUTOBOT_TOKEN=                           # API token (needs write perms if you want writes)
SSL_VERIFY=true                           # false for self-signed certificates

# --- Optional features ----------------------------------------------------------
# Semantic search over Nautobot's GitHub repos. Clones and indexes several large repos;
# set to false if you only need the Nautobot API tools.
NAUTOBOT_MCP_ENABLE_KB=true
GITHUB_TOKEN=                             # higher GitHub rate limits for the KB

# --- Where state is stored ------------------------------------------------------
# Indexes, cloned repos, the embedding model and repos added via the tools.
# Default: ~/.local/share/nautobot-mcp (use a persistent volume in containers)
# NAUTOBOT_MCP_DATA_DIR=/data

# --- Transport (CLI flags --mode/--host/--port take precedence) -----------------
MCP_TRANSPORT=stdio                       # stdio | http
MCP_HOST=127.0.0.1                        # use 0.0.0.0 inside a container
MCP_PORT=8000

# --- Tuning ---------------------------------------------------------------------
NAUTOBOT_MCP_DEFAULT_DEPTH=2               # depth added to GET requests; negative = omit
NAUTOBOT_MCP_MAX_RESPONSE_CHARS=60000     # largest API response returned (lists are trimmed)
NAUTOBOT_MCP_READY_WAIT=20                # seconds a tool waits for a warming index
API_TIMEOUT=10                            # seconds, per Nautobot API call
SCHEMA_TIMEOUT=120                        # seconds, fetching the Swagger schema
DEFAULT_SEARCH_RESULTS=5
LOG_LEVEL=INFO
API_PREFIX=nautobot_openapi               # prefix of the schema-search tool name
